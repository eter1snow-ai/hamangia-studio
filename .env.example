# HeavenlyNova Environment Variables
# Copiaza în .env.local și completează (NU comite .env.local în git)

# ─── Stripe ────────────────────────────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Printify ──────────────────────────────────────────────────────────────────
# Token JWT din Printify Dashboard → Connections → API Access
PRINTIFY_API_TOKEN=eyJ...
# ID-ul shop-ului din Printify Dashboard → My Stores (număr din URL)
PRINTIFY_SHOP_ID=12345678

# ─── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── General ───────────────────────────────────────────────────────────────────
SITE_URL=https://heavenlynova.com
